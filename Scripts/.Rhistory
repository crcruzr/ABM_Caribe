map_template <- function(raster_layer, title_text, group_label, bbox_extent = NULL) {
# Convert raster to SpatRaster -> stars or keep as terra for tmap
rast_sf <- as.data.frame(raster_layer, xy = TRUE, na.rm = TRUE)
colnames(rast_sf) <- c("x","y","value")
rast_sf <- st_as_sf(rast_sf, coords = c("x","y"), crs = crs(raster_layer))
# Base map with black background
tm <- tm_shape(raster_layer) +
tm_raster(palette = "viridis",  # color palette that stands out on black
style = "cont",       # continuous values
title = title_text) +
tm_shape(bbox_extent) +
tm_borders(col = "white", lty = "dotted", lwd = 1.5) +  # AOI dotted lines
tm_layout(frame = FALSE,
bg.color = "black",
main.title = paste(title_text, "-", group_label),
main.title.size = 1)
return(tm)
}
