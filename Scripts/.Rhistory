setwd('..')
getwd()
df_plot <- read.csv('tables/flooded_vs_totalPlot.csv')
# 100% stacked bar chart
p3 <-ggplot(df_plot, aes(x = Var1, y = Freq, fill = dataset)) +
geom_bar(stat = "identity", position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "",
x = "",
y = "Proportion",
fill = "Category"
) +
scale_fill_manual(values = c("Flooded\nareas" = "#56B4E9",  # blue
"Total\npopulation" = "#D55E00")) + # orange +
theme_minimal() +
theme(
text = element_text(size = 16),            # increases all text by default
plot.title = element_text(size = 20, face = "bold"), # larger title
axis.title = element_text(size = 18),      # axis titles
axis.text = element_text(size = 14),       # axis tick labels
legend.title = element_text(size = 16,face = "bold"),    # legend title
legend.text = element_text(size = 14)      # legend labels
)
library(terra)
library(tmap)
library(tidyverse)
library(sf)
df_plot <- read.csv('tables/flooded_vs_totalPlot.csv')
# 100% stacked bar chart
p3 <-ggplot(df_plot, aes(x = Var1, y = Freq, fill = dataset)) +
geom_bar(stat = "identity", position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "",
x = "",
y = "Proportion",
fill = "Category"
) +
scale_fill_manual(values = c("Flooded\nareas" = "#56B4E9",  # blue
"Total\npopulation" = "#D55E00")) + # orange +
theme_minimal() +
theme(
text = element_text(size = 16),            # increases all text by default
plot.title = element_text(size = 20, face = "bold"), # larger title
axis.title = element_text(size = 18),      # axis titles
axis.text = element_text(size = 14),       # axis tick labels
legend.title = element_text(size = 16,face = "bold"),    # legend title
legend.text = element_text(size = 14)      # legend labels
)
getwd()
ggsave("plots/Figure3.tif", plot = p3, width = 8, height = 6, dpi = 300)
library(ggplot2)
# Create dummy data
set.seed(123)
df <- data.frame(
x = rnorm(100),
y = rnorm(100),
Group = sample(c("A", "B"), 100, replace = TRUE),
Source = sample(c("Simulated", "Empirical"), 100, replace = TRUE)
)
df
# Plot
ggplot(df, aes(x = x, y = y, color = Group, shape = Source)) +
geom_point(size = 3) +
# Define shapes: 15 is square, 16 is circle
scale_shape_manual(values = c("Simulated" = 15, "Empirical" = 16)) +
# Define colors for the other legend
scale_color_manual(values = c("A" = "steelblue", "B" = "orange")) +
# Force the shape legend to use neutral colors regardless of the point colors
guides(
shape = guide_legend(override.aes = list(color = "grey50")),
color = guide_legend()
) +
theme_minimal() +
labs(shape = "Data Type", color = "Group")
# Dummy data in separate dataframes
simulated <- data.frame(x = rnorm(50), y = rnorm(50), Group = sample(c("A", "B"), 50, replace = TRUE))
empirical <- data.frame(x = rnorm(50), y = rnorm(50), Group = sample(c("A", "B"), 50, replace = TRUE))
ggplot() +
# Plot first dataframe: map shape to the string "Simulated"
geom_point(data = simulated, aes(x = x, y = y, color = Group, shape = "Simulated"), size = 3) +
# Plot second dataframe: map shape to the string "Empirical"
geom_point(data = empirical, aes(x = x, y = y, color = Group, shape = "Empirical"), size = 3) +
# Assign specific shapes (15 = square, 16 = circle)
scale_shape_manual(values = c("Simulated" = 15, "Empirical" = 16)) +
# Define colors for the Group legend
scale_color_manual(values = c("A" = "steelblue", "B" = "orange")) +
# Force the shape legend to have a neutral color
guides(
shape = guide_legend(override.aes = list(color = "grey50")),
color = guide_legend()
) +
theme_minimal() +
labs(shape = "Data Source", color = "Group")
empirical
