(length(files_found) == 0)
# --- Load raster stack and replace 0 with NA ---
fil <- rast(files_found)
# --- Loop through all combinations ---
for(t in 1:length(type) ){
for(n in 1:length(NotAv)){
for(g in 1:length(group)){
# --- List all runs (.asc) for this combination ---
files_found <- list.files(path = paste0(getwd(), wdir),
pattern = paste0("type-", type[t], "-mode-Infra and Transport-group-", g, "-NotAv-", NotAv[n],".asc" ),
full.names = TRUE)
if(length(files_found) == 0) next
# --- Load raster stack and replace 0 with NA ---
fil <- rast(files_found)
fil_NA <- classify(fil, cbind(0, NA))
# --- Create mask for residential polygons in current group ---
Gpart <- appl[appl$USO == "residencial" & appl$GRUPO == paste0("G", g)]
Gpart_mask <- rasterize(Gpart, fil_NA, field = 1, background = NA)
Gpart_mask[Gpart_mask == 1] <- 0
# --- Compute consolidated rasters ---
mean_r <- app(fil_NA, mean, na.rm = TRUE)
sd_r   <- app(fil_NA, sd, na.rm = TRUE)
cv_r   <- sd_r / mean_r
# --- Apply mask ---
mean_r[Gpart_mask != 0] <- NA
sd_r[Gpart_mask != 0]   <- NA
cv_r[Gpart_mask != 0]   <- NA
# --- Save rasters in the single folder with unique filenames ---
writeRaster(mean_r, file.path(out_dir, paste0(t, "_", gsub(" ", "_", mode), "_NotAv", n, "_G", g, "_mean.tif")), overwrite = TRUE)
writeRaster(sd_r,   file.path(out_dir, paste0(t, "_", gsub(" ", "_", mode), "_NotAv", n, "_G", g, "_sd.tif")),   overwrite = TRUE)
writeRaster(cv_r,   file.path(out_dir, paste0(t, "_", gsub(" ", "_", mode), "_NotAv", n, "_G", g, "_cv.tif")),   overwrite = TRUE)
# --- Compute global statistics ---
stats <- data.frame(
type      = t,
mode      = mode,
NotAv     = n,
group     = g,
Mean_mean = global(mean_r, mean, na.rm = TRUE)[1,1],
Mean_sd   = global(sd_r,   mean, na.rm = TRUE)[1,1],
Mean_cv   = global(cv_r,   mean, na.rm = TRUE)[1,1],
Min_mean  = global(mean_r, min,  na.rm = TRUE)[1,1],
Max_mean  = global(mean_r, max,  na.rm = TRUE)[1,1]
)
# --- Append to master summary table ---
if(!exists("summary_table_all")){
summary_table_all <- stats
} else {
summary_table_all <- rbind(summary_table_all, stats)
}
} # group
} # NotAv
} # type
# --- Save consolidated summary ---
write.csv(summary_table_all, file.path(out_dir, "Consolidated_Summary.csv"), row.names = FALSE)
# --- Function to create and save a mean map ---
create_mean_map <- function(raster_layer, output_folder, type, mode, NotAv, group, title_text = "Mean households") {
if(!dir.exists(output_folder)) dir.create(output_folder, recursive = TRUE)
# Generate a filename encoding the combination
file_name <- paste0(type, "_", gsub(" ", "_", mode), "_NotAv", NotAv, "_G", group, "_mean_map.tif")
# Save the raster as a GeoTIFF
writeRaster(raster_layer, file.path(output_folder, file_name), overwrite = TRUE)
# Optional: add plotting logic here if you want a visual map
# plot(raster_layer, main = title_text)
return(file.path(output_folder, file_name))
}
map_file <- create_mean_map(
raster_layer = mean_r,
output_folder = "path_to_maps_folder",
type = t,
mode = mode,
NotAv = n,
group = g
)
