df = read.csv("../Outputs/pixelapproach_80.csv")
vars <- grep("^TP19_EE_E[1-6]$", names(df), value = TRUE)
df$Estrato <- as.factor(df$Estrato)
for (v in vars) {
print(
ggplot(df, aes_string(x = v)) +
geom_histogram(bins = 30, fill = "skyblue", color = "black") +
facet_wrap(~ Estrato, scales = "free_y") +
labs(
title = paste("Histograma de", v, "por Estrato"),
