for (n in ("../Outputs/pixelapproach_80.csv", "../Outputs/pixelapproach_80pixelapproachFull")) {
# columnas de interés
vars <- paste0("TP19_EE_E", 1:6)
results <- data.frame()
for (i in 1:6) {
estrato_name <- paste0("E", i)
var_name <- vars[i]
df_sub <- df %>% filter(Estrato == estrato_name)
mean_val <- mean(df_sub[[var_name]], na.rm = TRUE)
sd_val   <- sd(df_sub[[var_name]], na.rm = TRUE)
results <- rbind(results, data.frame(
Estrato = estrato_name,
Variable = var_name,
Mean = mean_val,
SD = sd_val
))
}
results
