# Loop over all selected shapefiles
for (i in seq_along(filnm)) {
tf <- rast()  # Create an empty raster
# Create a raster with the same extent as the current vector,
# resolution as 'is', and coordinate reference system from 'tf'
tf <- rast(ext(vec[[i]]), resolution = res(is), crs = crs(tf))
# Rasterize the filtered vector data (vectmov) onto the raster 'tf',
# summing values if multiple points fall in the same cell
tfF <- rasterize(vectmov[[i]], tf, fun = sum)
# Write the raster to disk with the corresponding filename
writeRaster(tfF, filename = paste0('Outputs/', filnm[i], '.tif'), overwrite = TRUE)
}
